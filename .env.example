# Copy this file to ".env" (same folder) and fill in your own values.
# NEVER commit the real .env file or share it.

# Port where the KMart server will listen
PORT=5000

# development | production | test
NODE_ENV=development

# MongoDB connection string.
#   Local:  mongodb://127.0.0.1:27017/kmart
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kmart?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/kmart

# Long random string (at least 32 characters) used to sign login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Set to true only when the site is served over HTTPS (production)
COOKIE_SECURE=false

# A product with stock at or below this number is shown as "low stock"
LOW_STOCK_THRESHOLD=5

# ---- Used ONLY by "npm run create-admin" (remove ADMIN_PASSWORD afterwards) ----
ADMIN_NAME=Store Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Optional: separate database for automated tests (name must contain "test") ----
# If empty, tests use an in-memory MongoDB (downloaded automatically on first run).
TEST_MONGODB_URI=
